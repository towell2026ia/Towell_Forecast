APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000
ASSISTANT_PROVIDER=local
DATA_PROVIDER=normalized
PERSISTENCE_PROVIDER=sqlite
PERSISTENCE_MODE=local
RESEARCH_PROVIDER=local
DATA_DIR=
STATE_DIR=
SQLITE_PATH=
AI_ASSISTANT_UI_ENABLED=true
AI_ASSISTANT_API_ENABLED=false
HISTORICAL_RUNNER_ENABLED=true
LEGACY_PILOT_ENABLED=false
LOCAL_RESEARCH_ENABLED=true
LOCAL_INTENT_ROUTER_ENABLED=true
MONTHLY_RUNNER_ENABLED=true
OPENAI_ENABLED=false
DEEP_RESEARCH_ENABLED=false
VOICE_ENABLED=false
SUPABASE_ENABLED=false
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend READ only: public URL + anon/publishable key; never a service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production frontend/recovery origin. HTTPS; localhost only in development.
NEXT_PUBLIC_SITE_URL=
# Generated by build:netlify from COMMIT_REF or Git, not a manual secret.
NEXT_PUBLIC_GIT_SHA=
# E2: public Railway API origin. No secret or service key in this setting.
NEXT_PUBLIC_FORECAST_API_URL=
OPERATIONAL_PREVIEW_ENABLED=false
VINTAGE_PERSISTENCE_ENABLED=false
OFFICIAL_PUBLICATION_ENABLED=false
CHAMPION_PUBLICATION_ENABLED=false
SERVICE_TARGET_FILL_RATE=95.0
QUALITY_POLICY_VERSION=E3-GATES-1.0.0
MINIMUM_HISTORY_MONTHS=18
WARNING_CONTINUITY_RATE=0.85
READY_CONTINUITY_RATE=0.95
MINIMUM_IMPROVEMENT_POINTS=0
MAXIMUM_BIAS_DETERIORATION=5
CRITICAL_HORIZON_DEGRADATION=10
SUPABASE_PUBLISHABLE_KEY=
PYTHON_ASSISTANT_URL=http://127.0.0.1:8000
ASSISTANT_API_TOKEN=
ASSISTANT_MANAGER_IDS=
ASSISTANT_EDITOR_IDS=
ASSISTANT_READER_IDS=
MAX_FORECAST_RUNS=2
MAX_HISTORICAL_RUNS=1
ASSISTANT_RATE_PER_MINUTE=60
FORECAST_RATE_PER_MINUTE=10
HISTORICAL_RATE_PER_MINUTE=4
EXTERNAL_TIMEOUT_SECONDS=10
RETRY_MAX_ATTEMPTS=3
GIT_SHA=unknown
BUILD_TIME=unknown
APP_VERSION=0.11.0-prd09
CURRENT_USER_ROLE=manager

# Railway staging/bootstrap — copiar estos valores en Variables del servicio,
# no cargar este archivo completo. Railway entrega PORT: no fijar PORT ni API_PORT.
# APP_ENV=development
# API_HOST=0.0.0.0
# ASSISTANT_PROVIDER=local
# DATA_PROVIDER=normalized
# PERSISTENCE_PROVIDER=sqlite
# RESEARCH_PROVIDER=local
# SUPABASE_ENABLED=false
# OPENAI_ENABLED=false
# VOICE_ENABLED=false
# DEEP_RESEARCH_ENABLED=false
# AI_ASSISTANT_API_ENABLED=false
# LEGACY_PILOT_ENABLED=false
# RAILWAY_DOCKERFILE_PATH=Dockerfile.api
